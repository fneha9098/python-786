import tkinter as tk
from tkinter import messagebox

# ---------------------- RECURSION FUNCTIONS ----------------------

def factorial(n):
    if n == 0 or n == 1:
        return 1
    return n * factorial(n - 1)


def fibonacci(n):
    if n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

# ---------------------- MAIN APPLICATION CLASS ----------------------

class AdvancedApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Advanced Python GUI - Recursion & Exception Handling")
        self.root.geometry("700x500")
        self.root.configure(bg="#1e1e2f")

        # Title Label
        self.title_label = tk.Label(
            root,
            text="Recursion and exception handling",
            font=("Helvetica", 20, "bold"),
            bg="#1e1e2f",
            fg="white"
        )
        self.title_label.pack(pady=10)

        # Input Frame
        self.input_frame = tk.Frame(root, bg="#2b2b3c")
        self.input_frame.pack(pady=20)

        self.label = tk.Label(
            self.input_frame,
            text="Enter a number:",
            font=("Arial", 14),
            bg="#2b2b3c",
            fg="white"
        )
        self.label.grid(row=0, column=0, padx=10, pady=10)

        self.entry = tk.Entry(self.input_frame, font=("Arial", 14))
        self.entry.grid(row=0, column=1, padx=10, pady=10)

        # Buttons Frame
        self.button_frame = tk.Frame(root, bg="#1e1e2f")
        self.button_frame.pack(pady=20)

        self.fact_button = tk.Button(
            self.button_frame,
            text="Factorial",
            font=("Arial", 12),
            command=lambda: self.calculate("factorial"),
            bg="#4CAF50",
            fg="white",
            width=15
        )
        self.fact_button.grid(row=0, column=0, padx=10)

        self.fib_button = tk.Button(
            self.button_frame,
            text="Fibonacci",
            font=("Arial", 12),
            command=lambda: self.calculate("fibonacci"),
            bg="#2196F3",
            fg="white",
            width=15
        )
        self.fib_button.grid(row=0, column=1, padx=10)

        self.clear_button = tk.Button(
            self.button_frame,
            text="Clear",
            font=("Arial", 12),
            command=self.clear_fields,
            bg="#f44336",
            fg="white",
            width=15
        )
        self.clear_button.grid(row=0, column=2, padx=10)

        # Output Frame
        self.output_frame = tk.Frame(root, bg="#2b2b3c")
        self.output_frame.pack(pady=20, fill="both", expand=True)

        self.output_label = tk.Label(
            self.output_frame,
            text="Result will appear here",
            font=("Arial", 14),
            bg="#2b2b3c",
            fg="white"
        )
        self.output_label.pack(pady=20)

        # Footer
        self.footer = tk.Label(
            root,
            text="Using Recursion, Lambda & Exception Handling",
            font=("Arial", 10),
            bg="#1e1e2f",
            fg="gray"
        )
        self.footer.pack(side="bottom", pady=10)

    # ---------------------- CORE LOGIC ----------------------

    def calculate(self, operation):
        try:
            value = int(self.entry.get())

            if value < 0:
                raise ValueError("Negative numbers are not allowed!")

            if operation == "factorial":
                result = factorial(value)
                self.output_label.config(text=f"Factorial of {value} is {result}")

            elif operation == "fibonacci":
                result = fibonacci(value)
                self.output_label.config(text=f"Fibonacci of {value} is {result}")

        except ValueError as ve:
            messagebox.showerror("Input Error", str(ve))

        except Exception as e:
            messagebox.showerror("Unexpected Error", str(e))

    # ---------------------- CLEAR FUNCTION ----------------------

    def clear_fields(self):
        self.entry.delete(0, tk.END)
        self.output_label.config(text="Result will appear here")

# ---------------------- RUN APPLICATION ----------------------

if __name__ == "__main__":
    root = tk.Tk()
    app = AdvancedApp(root)
    root.mainloop()
